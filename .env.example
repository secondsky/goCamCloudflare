# Example environment configuration for the Cloudflare Worker.
#
# This file documents the variables the Worker reads. It is NOT loaded
# automatically by Wrangler. To use these values locally, copy the relevant
# lines into a `.dev.vars` file at the repo root (which is gitignored) or set
# them as secrets / vars via Wrangler:
#
#   npx wrangler secret put ENCRYPTION_KEY      # secret, required
#   npx wrangler deploy --var KEY:value         # non-secret var
#
# Non-secret vars are also defined statically in `wrangler.jsonc` under "vars".

# Secret — exactly 32 bytes of UTF-8. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('latin1'))"
ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_RANDOM_BYTES"

# Non-secret vars (defaults shown; override via wrangler.jsonc or --var).
# ENCRYPTION_ALGORITHM is optional; it defaults to "aes-256-gcm" and only that
# value is supported. The Worker hard-codes AES-GCM regardless of this setting.
ENCRYPTION_ALGORITHM="aes-256-gcm"
ENABLE_FRONTEND_DEBUG=false
