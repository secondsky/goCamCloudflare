{
	"name": "gocam-cloudflare",
	"version": "1.0.0",
	"description": "Age verification system - Cloudflare Workers port",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build:css": "sass source/frontend/css/main.scss app/frontend/static/css/main.css",
		"build:frontend": "cd ./script/; gulp buildJsFrontend",
		"tail": "wrangler tail",
		"types": "tsc --noEmit",
		"test": "vitest run",
		"test:workers": "vitest run --pool=workers",
		"test:watch": "vitest"
	},
	"author": "GoDotCam",
	"license": "AGPL-3.0",
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@cloudflare/workers-types": "^4.20250312.0",
		"@types/ua-parser-js": "^0.7.39",
		"gulp": "^5.0.0",
		"gulp-clean": "^0.4.0",
		"gulp-cli": "^3.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-typescript": "^6.0.0-alpha.1",
		"sass": "^1.76.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"ua-parser-js": "^1.0.37"
	}
}
